{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "psr-jumanah-presentation-edge",
  "main": "worker/jumanah-presentation-edge.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "routes": [
    { "pattern": "psrhomes.ae/advisors/jumanah/dubai-south*", "zone_name": "psrhomes.ae" },
    { "pattern": "www.psrhomes.ae/advisors/jumanah/dubai-south*", "zone_name": "psrhomes.ae" }
  ],
  "services": [
    { "binding": "PSR_ORIGIN", "service": "psr-property", "environment": "production" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
