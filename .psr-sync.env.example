# Copy to .psr-sync.env. The real file is ignored by Git.
# Keep secrets in the platform CLIs or macOS Keychain, never in this file.

PSR_SYNC_TARGETS=cloudflare,supabase,aws
PSR_AUTO_SYNC=0
# Start with dry-run. Change to apply only after one manual all-target release.
PSR_AUTO_SYNC_MODE=dry-run

# A dedicated PSR project is recommended. Do not point this at an unrelated
# shared project without reviewing its migration history and security posture.
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=psrhomes
SUPABASE_URL=
SUPABASE_DB_PASSWORD_KEYCHAIN_SERVICE=psrhomes.supabase.db-password
SUPABASE_SECRET_KEY_KEYCHAIN_SERVICE=psrhomes.supabase.secret-key

# Runtime verification after a successful Cloudflare deployment.
PSR_HEALTHCHECK_URLS=https://psrhomes.ae/,https://psrhomes.ae/agent

# Store the database password and server secret key with
# `npm run sync:secrets:store`. Never put either value in this file.

# Use a dedicated bucket and a least-privilege AWS CLI profile.
AWS_PROFILE=psrhomes-deployer
AWS_REGION=us-east-1
AWS_S3_BUCKET=psrhomes-source-613232991880-us-east-1
AWS_S3_PREFIX=psrhomes
