{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "psr-home-edge",
  "main": "worker/home-edge.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  // Internal/downstream edge. The public wildcard is owned by psr-media-edge.
  "routes": [],
  "services": [
    { "binding": "ORIGIN", "service": "psr-property", "environment": "production" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
