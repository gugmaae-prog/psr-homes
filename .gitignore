# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next / vinext
/.next/
/out/
/.vinext/
/dist/
/.wrangler/
/.sites-runtime/

# env / secrets — examples may be committed; real env files may not
.env*
!.env.example
.psr-sync.env
*.pem

# misc
.DS_Store
._*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# local
/output/
/outputs/
/tmp/
/work/
/artifacts/
/.sync/
/.vercel/
/.round3-backup/
*.dark-backup
/supabase/.temp/

# transfer artifacts and local chart blobs (not app source)
/.push-batches/
/.chart-data-*/
/psr-mcp-batches.tgz
__pycache__/
*.pyc

# public static assets stay on R2 / the live site
/public/
*.mp4
*.webm
*.mov
