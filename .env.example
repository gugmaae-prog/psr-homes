# Public production origin
NEXT_PUBLIC_SITE_ORIGIN=https://psrhomes.ae

# Private operational inbox used by the lead-delivery binding until an official
# PSR company-domain address is provisioned. It is never rendered publicly.
LEAD_NOTIFICATION_RECIPIENT=

# Email delivery is intentionally disabled. This must remain false until a
# company-local sender and explicit approval are both present.
CAMPAIGN_DELIVERY_ENABLED=false

# Optional company-local long-term memory. Leave blank to keep memory off.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Comma-separated PSR staff mailboxes already provisioned in both Cloudflare
# Email Routing and Email Sending. Admin account creation and email changes are
# blocked for addresses outside this allowlist.
EMAIL_PROVISIONED_ADDRESSES=
